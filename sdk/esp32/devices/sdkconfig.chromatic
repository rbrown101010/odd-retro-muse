# ModRetro Chromatic: ESP32-U4WDH rev3.1, 4MB embedded flash, no PSRAM.
# USB FPGA CDC bridge 33aa:0120. OSD 160x144 over QSPI, FPGA buttons over UART1.
# Sources: https://github.com/ModRetro/oss-chromatic-console-mcu
# main/board.h, main/main.c, main/fpga_rx.c, components/button/button.h.
# Load after sdkconfig.defaults and devices/sdkconfig.ideaspark.
CONFIG_HOMEHUB_CHROMATIC=y
CONFIG_HOMEHUB_LED_BACKEND_NONE=y
CONFIG_HOMEHUB_SHOW_AGENT_NAME=y
CONFIG_HOMEHUB_DISPLAY_COMMANDS=n
CONFIG_HOMEHUB_SUPPORT_BUG_REPORT=n
CONFIG_HOMEHUB_BLE_NAME_PREFIX="MuseGadget"
CONFIG_HOMEHUB_BLE_NAME_SUFFIX="-Chromatic"
CONFIG_GADGET_PRODUCT_NAME="Muse Chromatic"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_chromatic.csv"
CONFIG_HOMEHUB_OTA_ENABLED=n
CONFIG_HOMEHUB_TUNNEL=n
CONFIG_HOMEHUB_VOICE=n
CONFIG_MUSE_ENABLED=n
CONFIG_SPIRAM=n
CONFIG_HOMEHUB_NVS_ENCRYPTION=n
CONFIG_NVS_ENCRYPTION=n
CONFIG_HOMEHUB_PAIRING_EFUSE_AUTH=n
CONFIG_SECURE_BOOT=n
CONFIG_SECURE_FLASH_ENC_ENABLED=n
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_TASK_WDT_EN=y
